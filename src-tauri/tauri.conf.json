{
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devPath": "http://localhost:1420",
        "distDir": "../dist",
        "withGlobalTauri": false
    },
    "package": {
        "productName": "Binary Command Editor",
        "version": "0.1.0"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "fs": {
                "all": false,
                "readFile": true,
                "writeFile": true,
                "exists": true,
                "scope": [
                    "**"
                ]
            },
            "dialog": {
                "all": false,
                "open": true,
                "save": true
            },
            "path": {
                "all": true
            },
            "shell": {
                "all": false,
                "open": true
            }
        },
        "bundle": {
            "active": true,
            "targets": "all",
            "identifier": "com.binaryeditor.app",
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/128x128@2x.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ]
        },
        "security": {
            "csp": null
        },
        "windows": [
            {
                "fullscreen": false,
                "resizable": true,
                "title": "Binary Command Editor",
                "width": 1200,
                "height": 900,
                "minWidth": 800,
                "minHeight": 600
            }
        ]
    }
}